# La base local. Nunca se versiona: guarda Comentarios con el teléfono del
# Colono que los escribió, y el historial de git no se puede depurar después.
# El contenido que sí debe viajar al servidor va en el seeder.
/database/*.sqlite
/database/*.sqlite-shm
/database/*.sqlite-wal

/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage

# Assets del panel de Filament. Los republica `filament:upgrade`, que ya corre
# en el `post-autoload-dump` de composer, así que versionarlos solo genera
# conflictos con cada actualización del paquete.
/public/css/filament
/public/js/filament
/public/fonts/filament
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Config local de YouTrack: puede contener un token permanente.
/.ralph
# Cache de issues y sus previews. El comodin no es de mas: el runbook pide
# generar issues-resolved.preview.json y CHANGELOG.preview.md para revisarlos
# antes de sobreescribir los reales, y release.ps1 hace `git add -A` -- sin esto
# el archivo de revision se va dentro del commit de release.
issues-resolved*.json
CHANGELOG.preview.md
